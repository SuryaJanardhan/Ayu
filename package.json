{
  "name": "ayu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/generate-bundle-html.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "eas:build:apk": "npx --yes eas-cli build -p android --profile preview",
    "eas:build:android": "npx --yes eas-cli build -p android --profile production",
    "eas:build:ios": "npx --yes eas-cli build -p ios --profile preview",
    "eas:update:preview": "npm run build && npx --yes eas-cli update --channel preview",
    "eas:update:production": "npm run build && npx --yes eas-cli update --channel production"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "expo": "~51.0.39",
    "expo-updates": "~0.25.28",
    "graphql": "^17.1.0",
    "lucide-react": "^0.468.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
